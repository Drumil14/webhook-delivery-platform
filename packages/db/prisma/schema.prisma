// Phase 1 schema: real core domain for event ingestion.
//
// Prisma 7 notes:
//  - The `prisma-client` generator (no `-js`) writes the client into the
//    source tree (see `output`), which is why it is gitignored.
//  - A driver adapter (@prisma/adapter-pg) is mandatory at runtime; the
//    connection is wired up in src/client.ts. The CLI URL lives in the
//    root prisma.config.ts.
//
// Scope guardrail: NO Delivery / DeliveryAttempt / queue models yet — those are
// Phase 2+.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // partialIndexes: a Preview feature introduced in Prisma 7.4 (we are on 7.10),
  // with migrate + introspection support. Needed for the "one automatic Delivery
  // per Event" partial unique index below — expressing it in the schema (rather
  // than raw SQL only) is what keeps `prisma migrate` drift-free.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum EndpointStatus {
  active
  paused
}

/// Minimal V1 account. Exists so ownership boundaries are real; there is NO
/// login/signup/session system yet. V1 uses a single seeded demo account.
model Account {
  id         String   @id @default(uuid())
  name       String
  apiKeyHash String
  createdAt  DateTime @default(now())

  endpoints Endpoint[]
  events    Event[]
}

/// A webhook destination owned by an Account. In Phase 1 it exists mainly so an
/// Event can target something real. No HMAC/rotation/SSRF/rate-limiting/delivery
/// behavior yet.
model Endpoint {
  id                 String         @id @default(uuid())
  accountId          String
  url                String
  // NOTE: field is named `secretEncrypted` for the frozen schema, but real
  // encryption is a future phase. Phase 1 stores a randomly generated secret.
  secretEncrypted    String
  status             EndpointStatus @default(active)
  rateLimitPerMinute Int            @default(60)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  events  Event[]

  @@index([accountId])
}

/// An ingested event targeting one Endpoint.
///
/// - `payload`  (jsonb): parsed body, used for querying/display.
/// - `payloadRaw` (text): the exact serialized body received; the canonical
///   source of bytes that future phases will sign and deliver.
/// - `payloadFingerprint`: SHA-256 over (endpointId + payloadRaw), so the same
///   idempotency key with the same body but a DIFFERENT endpoint is treated as a
///   different operation.
model Event {
  id                 String   @id @default(uuid())
  accountId          String
  endpointId         String
  eventType          String
  payload            Json
  payloadRaw         String
  idempotencyKey     String
  payloadFingerprint String
  receivedAt         DateTime @default(now())

  account    Account    @relation(fields: [accountId], references: [id])
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id])
  deliveries Delivery[]

  // The database unique constraint is the AUTHORITY for idempotency (see
  // apps/web/lib/ingest.ts — INSERT ... ON CONFLICT DO NOTHING).
  @@unique([accountId, idempotencyKey])
  @@index([accountId, receivedAt])
  @@index([endpointId])
}

enum DeliveryStatus {
  pending
  succeeded
  dead
  // NOTE: no `in_progress` state — deliberately removed from the architecture.
}

enum DeliveryTrigger {
  automatic
  // `manual_replay` exists for the final architecture but is NOT used in Phase 2.
  manual_replay
}

/// A durable attempt-to-deliver record for an Event. Phase 2 creates exactly one
/// AUTOMATIC Delivery per Event (status=pending, attemptCount=0) atomically with
/// the Event and the pg-boss job. Replay (Phase 7) will add manual_replay rows.
///
/// Future phase note: DeliveryAttempt (Phase 3), status transitions, retries,
/// and replay wiring are NOT implemented yet.
model Delivery {
  id                 String          @id @default(uuid())
  eventId            String
  status             DeliveryStatus  @default(pending)
  attemptCount       Int             @default(0)
  // Matches the active demo retry policy (6 attempts). Phase 5 will derive/set
  // this explicitly from the selected retry policy.
  maxAttempts        Int             @default(6)
  nextRetryAt        DateTime?
  triggeredBy        DeliveryTrigger @default(automatic)
  replayOfDeliveryId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  event    Event             @relation(fields: [eventId], references: [id])
  replayOf Delivery?         @relation("DeliveryReplays", fields: [replayOfDeliveryId], references: [id])
  replays  Delivery[]        @relation("DeliveryReplays")
  attempts DeliveryAttempt[]

  @@index([eventId])
  // Frozen index for the future retry sweeper (Phase 3+): find due deliveries.
  @@index([status, nextRetryAt])
  // At most ONE automatic Delivery per Event. Partial unique index so replay can
  // still add additional (manual_replay) Delivery rows for the same Event later.
  // NOT a plain UNIQUE(eventId) — that would block Phase 7 replay.
  @@unique([eventId], where: raw("\"triggeredBy\" = 'automatic'"), map: "Delivery_eventId_automatic_key")
}

enum DeliveryAttemptOutcome {
  success
  failure
  // Phase 3 does not actively exercise these; they belong to later phases but
  // exist now as part of the frozen schema.
  timeout
  network_error
}

/// One HTTP attempt to deliver a Delivery to its Endpoint. Immutable history:
/// a new row per attempt (attemptNumber). Separate from Delivery so the Delivery
/// holds current state while attempts hold the full audit trail.
///
/// Future phase note: `resolvedIp` stays null until Phase 6 adds the hardened
/// resolve-validate-pin networking layer. Do not fake an IP.
model DeliveryAttempt {
  id                  String                 @id @default(uuid())
  deliveryId          String
  attemptNumber       Int
  requestHeaders      Json
  responseStatus      Int?
  responseHeaders     Json?
  responseBodySnippet String?
  errorMessage        String?
  durationMs          Int
  resolvedIp          String?
  outcome             DeliveryAttemptOutcome
  attemptedAt         DateTime               @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, attemptedAt])
}
