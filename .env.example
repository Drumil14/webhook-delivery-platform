# Single source of truth for both apps/web and apps/worker.
# Copy this file to `.env` and fill in a real PostgreSQL connection string.
#
#   cp .env.example .env
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# (managed providers like Neon/Supabase usually require sslmode=require)

DATABASE_URL=

# Server-side master key used to encrypt endpoint webhook signing secrets at rest
# (AES-256-GCM). This is NOT an endpoint secret — it is one server-wide key.
#
# REQUIRED: exactly 32 random bytes, base64-encoded. The app fails closed
# (refuses to start / decrypt) if this is missing or not exactly 32 bytes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: rotating/regenerating it makes previously stored secrets
# undecryptable. Never commit the real value.
WEBHOOK_SECRET_ENCRYPTION_KEY=
