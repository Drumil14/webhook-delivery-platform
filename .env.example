# Single source of truth for both apps/web and apps/worker.
# Copy this file to `.env` and fill in a real PostgreSQL connection string.
#
#   cp .env.example .env
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# (managed providers like Neon/Supabase usually require sslmode=require)

DATABASE_URL=

# Realtime (Phase 8) LISTEN/NOTIFY connection. The web process holds ONE
# persistent PostgreSQL session for `LISTEN delivery_updates`. This MUST be a
# DIRECT (non-pooler) connection — a transaction pooler (e.g. Neon's `-pooler`
# host / PgBouncer) does NOT support LISTEN/NOTIFY, so notifications never arrive.
# On Neon, use the direct host (the pooler host with `-pooler` removed).
# Optional: if unset, the listener falls back to DATABASE_URL (fine only when that
# is already a direct connection). Never commit the real value.
DATABASE_URL_UNPOOLED=

# Server-side master key used to encrypt endpoint webhook signing secrets at rest
# (AES-256-GCM). This is NOT an endpoint secret — it is one server-wide key.
#
# REQUIRED: exactly 32 random bytes, base64-encoded. The app fails closed
# (refuses to start / decrypt) if this is missing or not exactly 32 bytes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: rotating/regenerating it makes previously stored secrets
# undecryptable. Never commit the real value.
WEBHOOK_SECRET_ENCRYPTION_KEY=
